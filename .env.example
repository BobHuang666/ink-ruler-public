# 复制本文件为 .env 并填写实际值（不提交 .env 到版本库）
# 后端启动与种子脚本都会自动加载 .env

# 数据库（可选，未设则用 config.yaml）
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
DB_PASSWORD=

# JWT 密钥（生产环境必填）
JWT_SECRET=

# 邮箱验证码发信（注册验证码必配，否则无法发送）
SMTP_PASSWORD= 

# 智能搜索（智能增强 + 语义检索）与 OCR 使用的 SiliconFlow API
SILICONFLOW_API_KEY=

# 作文批改 GPU 网关（空则走 mock）；腾讯云 CVM 按需开机
GPU_GATEWAY_URL=
GPU_REQUEST_TIMEOUT_SECONDS=300
GPU_IDLE_SHUTDOWN_SECONDS=60
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_CVM_INSTANCE_ID=
TENCENT_CLOUD_REGION=ap-shanghai